# Variables used to deploy the site. Real values live in the 1Password
# Environment "portfolio-web" and are injected by `op run` in the root deploy
# scripts. This file only documents the names; do not put real values here.
# The build itself reads no environment variables.

# Deploy only (used by Wrangler)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
