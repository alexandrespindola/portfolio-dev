---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import TagList from "../../components/TagList.astro";
import TAGS from "../../data/tags";
import LinkButton from "../../components/LinkButton.astro";
import GitHubIcon from "../../components/icons/GitHubIcon.astro";
import LinkIcon from "../../components/icons/LinkIcon.astro";

export async function getStaticPaths() {
  const entries = await getCollection("caseStudies");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const tags = data.tagKeys.map((key) => TAGS[key as keyof typeof TAGS]);
---

<Layout title={`${data.title} | Alexandre Spindola`} description={data.summary} image="/og.jpg">
  <main id="main-content" class="pb-20 pt-20 md:pt-24">
    <SectionContainer>
      <a href="/#projects" class="text-sm font-semibold text-primary transition hover:text-white">← Back to selected work</a>
      <p class="mt-5 text-xs font-medium uppercase tracking-[0.2em] text-primary">Case study · {data.category} · {data.visibility === "private" ? "Private project" : "Public product"}</p>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-5">
        <div>
          <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-5xl">{data.title}</h1>
          <p class="mt-5 max-w-3xl text-xl leading-relaxed text-gray-300">{data.summary}</p>
        </div>
        <div class="rounded-xl border border-primary/25 bg-primary/5 px-4 py-3 text-sm">
          <p class="font-semibold text-primary">{data.status}</p>
          <p class="mt-1 text-gray-400">{data.period}</p>
        </div>
      </div>
      <div class="relative mt-10 aspect-[16/7] overflow-hidden rounded-2xl border border-gray-800 bg-gray-900">
        {data.cover ? <img src={data.cover} alt={`${data.title} preview`} width="1200" height="525" class="h-full w-full object-cover" /> : <div class="flex h-full items-center justify-center bg-[radial-gradient(circle_at_75%_20%,rgba(64,234,30,0.18),transparent_38%)] p-6 text-center text-sm font-medium uppercase tracking-[0.18em] text-gray-500">Case study visual coming soon</div>}
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.6fr)]">
        <article class="space-y-8">
          <section><h2 class="text-xl font-bold text-white">The challenge</h2><p class="mt-3 leading-relaxed text-gray-300">{data.challenge}</p></section>
          <section><h2 class="text-xl font-bold text-white">Approach</h2><p class="mt-3 leading-relaxed text-gray-300">{data.solution}</p></section>
          <section><h2 class="text-xl font-bold text-white">What was delivered</h2><ul class="mt-3 space-y-3 text-gray-300">{data.outcomes.map((outcome) => <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>{outcome}</li>)}</ul></section>
        </article>
        <aside class="h-fit rounded-2xl border border-gray-800 bg-gray-900 p-6">
          <p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">My role</p><p class="mt-2 font-semibold text-white">{data.role}</p>
          {data.metrics.length > 0 && <div class="mt-6"><p class="text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Proof points</p><ul class="mt-3 space-y-2 text-primary">{data.metrics.map((metric) => <li>{metric}</li>)}</ul></div>}
          <div class="mt-6"><p class="mb-2 text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Technology</p><TagList tags={tags} /></div>
          {(data.liveUrl || data.repositoryUrl) && <div class="mt-6 flex flex-wrap gap-3">{data.repositoryUrl && <LinkButton href={data.repositoryUrl}><GitHubIcon class="size-5" />Code</LinkButton>}{data.liveUrl && <LinkButton href={data.liveUrl}><LinkIcon class="size-4" />Live project</LinkButton>}</div>}
        </aside>
      </div>
      <section class="mt-16">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Visual walkthrough</p><h2 class="mt-2 text-2xl font-bold text-white">Project screens</h2></div>
          <p class="text-sm text-gray-500">Three visual slots ready for project imagery.</p>
        </div>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {data.gallery.map((image, index) => (
            <figure class="group overflow-hidden rounded-2xl border border-gray-800 bg-gray-900">
              <div class="relative aspect-[4/3] overflow-hidden">
                {image.src ? <img src={image.src} alt={image.alt} width="800" height="600" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /> : <div class="flex h-full flex-col justify-between bg-[radial-gradient(circle_at_80%_15%,rgba(64,234,30,0.16),transparent_35%),linear-gradient(145deg,#1c1c1c,#0d0d0d)] p-5"><span class="font-mono text-xs text-primary">0{index + 1}</span><div class="space-y-2"><div class="h-2 w-20 rounded bg-primary/70"></div><div class="h-2 w-full rounded bg-gray-700"></div><div class="h-2 w-4/5 rounded bg-gray-800"></div></div></div>}
              </div>
              <figcaption class="border-t border-gray-800 px-4 py-3 text-sm text-gray-400"><span>{image.label}</span>{!image.src && <span class="mt-1 block text-xs font-medium uppercase tracking-[0.12em] text-primary/80">Visual coming soon</span>}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    </SectionContainer>
  </main>
</Layout>
