---
import Card from "./Card.astro";
import TagList from "./TagList.astro";
import LinkButton from "./LinkButton.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkIcon from "./icons/LinkIcon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  variant: "featured" | "compact";
  eager?: boolean;
}

const { project, variant, eager = false } = Astro.props as Props;
const isFeatured = variant === "featured";
const internalLink = project.link?.startsWith("/");
const projectId = `project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;
---

<article>
  <Card hover class="flex h-full flex-col overflow-hidden">
    <div class="flex h-full flex-col">
      <div class={`relative overflow-hidden bg-[#1a1a1a] ${isFeatured ? "aspect-[16/9]" : "aspect-[16/10]"}`}>
        <div class="absolute inset-0 overflow-hidden bg-gradient-to-br from-[#202020] via-[#151515] to-[#090909] p-6">
          <div class="absolute -right-10 -top-10 size-36 rounded-full bg-primary/10 blur-2xl"></div>
          <div class="relative flex h-full flex-col justify-between rounded-lg border border-[#343434] bg-[#151515]/80 p-4">
            <div class="flex items-center justify-between"><span class="h-2 w-16 rounded-full bg-primary/70"></span><span class="size-2 rounded-full bg-[#4a4a4a]"></span></div>
            <div class="space-y-2"><span class="block h-3 w-3/4 rounded bg-[#4a4a4a]/70"></span><span class="block h-2 w-full rounded bg-[#363636]"></span><span class="block h-2 w-4/5 rounded bg-[#363636]"></span></div>
            <span class="text-xs font-medium uppercase tracking-[0.2em] text-gray-400">{project.image ? "Project preview" : "Visual coming soon"}</span>
          </div>
        </div>
        {project.image && <img
          src={project.image}
          alt={project.title}
          width="1200"
          height="750"
          loading={eager ? "eager" : "lazy"}
          class="absolute inset-0 h-full w-full object-cover transition duration-500 hover:scale-105"
        />}
      </div>
      <div class="flex flex-1 flex-col p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">{project.category}</p>
        <h3 class={`mt-2 ${isFeatured ? "text-2xl" : "text-lg"} font-bold text-primary`}>{project.title}</h3>
        {project.proof && <p class="mt-2 text-sm font-semibold text-primary">{project.proof}</p>}
        <p class={`mt-3 leading-relaxed text-gray-400 ${isFeatured ? "" : "line-clamp-3"}`}>{project.description}</p>
        <div class="mt-auto pt-4"><TagList tags={project.tags} max={3} /></div>
        {!isFeatured && (project.link || project.github) && (
          <footer class="mt-5 flex flex-wrap items-end gap-3">
            {project.github && <LinkButton href={project.github}><GitHubIcon class="size-5" />Code</LinkButton>}
            {project.link && <LinkButton href={project.link} target={internalLink ? "_self" : "_blank"}><LinkIcon class="size-4" />Preview</LinkButton>}
          </footer>
        )}
        {isFeatured && project.caseStudy ? (
          <div class="mt-5 grid grid-cols-2 gap-3 border-t border-[#292929] pt-4">
            <button type="button" data-project-open={projectId} class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#454545] bg-[#202020] px-3 py-2 text-sm font-semibold text-gray-200 transition hover:border-primary hover:text-primary">
              View complete project <span aria-hidden="true">↗</span>
            </button>
            <LinkButton href={project.caseStudy} target="_self" class="w-full px-2 text-center text-sm">Read case study <span aria-hidden="true">→</span></LinkButton>
          </div>
        ) : <>
          {project.caseStudy && <LinkButton href={project.caseStudy} target="_self" class="mt-4">Read case study <span aria-hidden="true">→</span></LinkButton>}
          <button type="button" data-project-open={projectId} class="mt-5 inline-flex items-center gap-2 border-t border-gray-800 pt-4 text-sm font-semibold text-gray-300 transition hover:text-primary">
            View complete project <span aria-hidden="true">↗</span>
          </button>
        </>}
      </div>
    </div>
  </Card>

  <dialog id={projectId} aria-labelledby={`${projectId}-title`} class="m-auto w-[min(92vw,72rem)] max-w-none rounded-2xl border border-[#343434] bg-[#121212] p-0 text-white shadow-2xl backdrop:bg-black/80">
    <div class="max-h-[88vh] overflow-y-auto p-5 sm:p-8">
      <div class="mb-6 flex items-start justify-between gap-6">
        <div><p class="text-xs font-medium uppercase tracking-[0.18em] text-primary">Project details</p><h2 id={`${projectId}-title`} class="mt-2 text-2xl font-bold sm:text-3xl">{project.title}</h2></div>
        <button type="button" data-project-close={projectId} class="flex size-10 shrink-0 items-center justify-center rounded-full border border-[#454545] text-xl text-gray-300 transition hover:border-primary hover:text-primary" aria-label="Close project details">×</button>
      </div>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)]">
        <div class="relative aspect-[16/10] overflow-hidden rounded-xl bg-[#090909]">
          <span class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm font-medium text-gray-500">{project.image ? "Full project preview" : "Project visual coming soon"}</span>
          {project.image && <img src={project.image} alt={`${project.title} full preview`} width="1200" height="900" loading="lazy" class="absolute inset-0 h-full w-full object-contain" />}
        </div>
        <div>
          <p class="leading-relaxed text-gray-300">{project.description}</p>
          <div class="mt-6"><p class="mb-2 text-xs font-medium uppercase tracking-[0.16em] text-gray-500">Full technology stack</p><TagList tags={project.tags} /></div>
          {(project.link || project.github) && <footer class="mt-6 flex flex-wrap gap-3">
            {project.github && <LinkButton href={project.github}><GitHubIcon class="size-5" />Code</LinkButton>}
            {project.link && <LinkButton href={project.link} target={internalLink ? "_self" : "_blank"}><LinkIcon class="size-4" />Preview</LinkButton>}
          </footer>}
        </div>
      </div>
    </div>
  </dialog>
</article>
