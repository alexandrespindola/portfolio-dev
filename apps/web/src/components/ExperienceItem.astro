---
import LinkInline from "../components/LinkInline.astro";

interface Props {
  title: string;
  company: string;
  highlights: { label: string; text: string }[];
  link?: string;
  date: string;
  location?: string;
}

const { title, company, highlights, link, date, location } =
  Astro.props as Props;
---

<div
  class="relative mx-12 grid pb-12 before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span
        class="absolute -left-[42px] rounded-full text-5xl text-primary"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-primary">
        {title}
      </h3>
      <h4 class="text-xl font-semibold text-white">
        {company}
      </h4>
      <time class="m-0 p-0 text-sm text-white/80"
        >{date}</time
      >
      {
        location && (
          <p class="text-sm text-white/60">{location}</p>
        )
      }
    </div>
  </div>
  <div
    class="relative flex flex-col gap-2 pb-4 text-gray-300 md:col-span-3"
  >
    <ul class="space-y-4">
      {highlights.map((highlight) => (
        <li class="flex gap-3">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          <span><strong class="text-white">{highlight.label}:</strong> {highlight.text}</span>
        </li>
      ))}
    </ul>
    {
      link && (
        <LinkInline href={link}>
          More info{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-chevron-right mt-0.5 w-5 text-primary"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
