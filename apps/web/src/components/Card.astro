---
interface Props {
  class?: string;
  hover?: boolean;
  id?: string;
}

const { class: className = "", hover = false, id } = Astro.props as Props;
---

<div id={id} class={`rounded-2xl border border-[#292929] bg-[#121212] shadow-sm ${hover ? "transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" : ""} ${className}`}>
  <slot />
</div>
