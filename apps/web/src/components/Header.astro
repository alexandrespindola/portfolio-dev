---
import MenuIcon from "./icons/MenuIcon.astro";
import CloseIcon from "./icons/CloseIcon.astro";

const navItems = [
  { title: "Projects", label: "projects", url: "/#projects" },
  { title: "Services", label: "services", url: "/#services" },
  { title: "Experience", label: "experience", url: "/#experience" },
  { title: "Tech Stack", label: "tech-stack", url: "/#tech-stack" },
  { title: "About", label: "about", url: "/#about" },
  { title: "Contact", label: "contact-cta", url: "/#contact-cta" },
];
---

<header class="fixed top-0 z-50 mt-3 flex w-full justify-end px-4 md:mt-2 md:justify-center md:px-3">
  <nav class="hidden items-center justify-center rounded-full bg-gray-800/90 px-3 text-sm font-medium text-gray-200 shadow-sm backdrop-blur md:flex">
    {navItems.map((link) => (
      <a class="relative block px-2 py-2 transition hover:text-primary" aria-label={link.label} href={link.url}>{link.title}</a>
    ))}
  </nav>
  <details class="group relative md:hidden">
    <summary
      class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-gray-700 bg-gray-800/90 text-gray-200 shadow-sm backdrop-blur transition group-open:text-primary marker:content-none"
      aria-label="Toggle menu"
    >
      <MenuIcon class="size-5 group-open:hidden" />
      <CloseIcon class="hidden size-5 group-open:block" />
    </summary>
    <nav class="absolute right-0 mt-2 flex w-44 flex-col gap-1 rounded-2xl border border-gray-700 bg-gray-900/95 p-2 shadow-xl backdrop-blur">
      {navItems.map((link) => (
        <a class="rounded-xl px-3 py-2 text-sm font-medium text-gray-200 transition hover:bg-gray-800 hover:text-primary" aria-label={link.label} href={link.url}>{link.title}</a>
      ))}
    </nav>
  </details>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navItems = document.querySelectorAll("header nav a");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navItems.forEach((item) => {
          const active = item.getAttribute("aria-label") === entry.target.id;
          item.classList.toggle("text-primary", active);
          item.toggleAttribute("aria-current", active);
        });
      });
    }, { root: null, rootMargin: "0px", threshold: 0.3 });
    sections.forEach((section) => observer.observe(section));

    const menu = document.querySelector("header details");
    if (menu) {
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.removeAttribute("open"));
      });
      document.addEventListener("click", (event) => {
        if (menu.hasAttribute("open") && !menu.contains(event.target as Node)) {
          menu.removeAttribute("open");
        }
      });
    }
  });
</script>
