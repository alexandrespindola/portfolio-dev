---
import TAGS from "../data/tags";
import Card from "./Card.astro";
import Chip from "./Chip.astro";
---

<div class="mt-16">
  <div class="grid gap-6 md:grid-cols-3">
    {/* Frontend */}
    <Card class="p-6">
      <h3 class="mb-4 text-lg font-semibold text-white">Frontend</h3>
      <ul class="flex flex-wrap gap-2">
        {[TAGS.VUE, TAGS.NUXT, TAGS.SVELTE, TAGS.ASTRO, TAGS.TAILWIND, TAGS.VITE, TAGS.TYPESCRIPT].map((tag) => (
          <li>
            <Chip {tag} />
          </li>
        ))}
      </ul>
    </Card>

    {/* Backend & APIs */}
    <Card class="p-6">
      <h3 class="mb-4 text-lg font-semibold text-white">Backend, Data & APIs</h3>
      <ul class="flex flex-wrap gap-2">
        {[TAGS.RUST, TAGS.NEST, TAGS.HONO, TAGS.NODE, TAGS.TYPESCRIPT, TAGS.POSTGRE, TAGS.REDIS].map((tag) => (
          <li>
            <Chip {tag} />
          </li>
        ))}
      </ul>
    </Card>

    {/* DevOps & Infra */}
    <Card class="p-6">
      <h3 class="mb-4 text-lg font-semibold text-white">DevOps & Infra</h3>
      <ul class="flex flex-wrap gap-2">
        {[TAGS.DOCKER, TAGS.LINUX, TAGS.GOOGLECLOUD, TAGS.CLOUDFLARE, TAGS.AWS, TAGS.DIGITALOCEAN, TAGS.RAILWAY].map((tag) => (
          <li>
            <Chip {tag} />
          </li>
        ))}
      </ul>
    </Card>

    {/* Databases & Realtime */}
    <Card class="p-6">
      <h3 class="mb-4 text-lg font-semibold text-white">Search, Queues & Realtime</h3>
      <ul class="flex flex-wrap gap-2">
        {[TAGS.POSTGRE, TAGS.REDIS, TAGS.SUPABASE, TAGS.N8N].map((tag) => (
          <li>
            <Chip {tag} />
          </li>
        ))}
      </ul>
    </Card>

    {/* AI & Automation */}
    <Card class="p-6">
      <h3 class="mb-4 text-lg font-semibold text-white">AI & Automation</h3>
      <ul class="flex flex-wrap gap-2">
        {[TAGS.CLAUDE, TAGS.GEMINI, TAGS.N8N, TAGS.WINDMILL, TAGS.POSTGRE].map((tag) => (
          <li>
            <Chip {tag} />
          </li>
        ))}
      </ul>
    </Card>

    {/* Tooling */}
    <Card class="p-6">
      <h3 class="mb-4 text-lg font-semibold text-white">Tooling</h3>
      <ul class="flex flex-wrap gap-2">
        {[TAGS.NODE, TAGS.BUN, TAGS.PNPM, TAGS.YARN].map((tag) => (
          <li>
            <Chip {tag} />
          </li>
        ))}
      </ul>
    </Card>
  </div>
</div>
