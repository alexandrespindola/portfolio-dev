---
import Badge from "../components/Badge.astro";
import MailIcon from "../components/icons/MailIcon.astro";
import XingIcon from "../components/icons/XingIcon.astro";
import SocialPill from "../components/SocialPill.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const heroImage = existsSync(join(process.cwd(), "public", "hero.webp"));
---

<div class="relative grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)] lg:items-center lg:gap-16">
  <div class="absolute -left-5 top-2 hidden h-32 w-px bg-gradient-to-b from-primary via-primary/30 to-transparent md:block"></div>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-3">
      <Badge>AI-Native Full-Stack Engineer · GCP Certified · EU Citizen</Badge>
      <span class="inline-flex items-center gap-2 text-sm text-gray-400"><span class="size-2 rounded-full bg-primary shadow-[0_0_12px_#40ea1e]"></span>Available for B2B contracts</span>
    </div>
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl">Alexandre Spindola</h1>
    <p class="mt-3 max-w-xl text-2xl font-semibold leading-tight text-gray-200 sm:text-3xl">Building reliable systems for <span class="text-primary">complex operations.</span></p>
    <ul class="mt-6 flex flex-wrap gap-3 text-sm font-medium text-gray-300" aria-label="Selected proof points">
      <li class="rounded-full border border-gray-700 px-3 py-1.5"><span class="text-primary">3,905</span> registrations in production</li>
      <li class="rounded-full border border-gray-700 px-3 py-1.5">Multilingual content platform</li>
      <li class="rounded-full border border-gray-700 px-3 py-1.5"><span class="text-primary">11</span>-process RPA modernisation programme</li>
    </ul>
    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-gray-300">
      <strong>AI-enabled products</strong>, automation and multilingual web platforms designed to modernise legacy systems into scalable, maintainable solutions. The core stack combines <strong>Rust</strong>, <strong>TypeScript</strong>, <strong>NestJS</strong>, <strong>Svelte</strong>, <strong>Vue</strong>, <strong>n8n</strong> and <strong>Cloudflare</strong>.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <SocialPill href="mailto:alexandre@spindola.me?subject=Portfolio%20enquiry"><MailIcon class="size-4" />Start a conversation</SocialPill>
      <SocialPill href="https://bucket.spindola.me/cv/CV-EN-ALEXANDRE-SPINDOLA-AI-Native-Full-Stack-Engineer-21-09-2026.pdf">🇬🇧 CV English</SocialPill>
      <SocialPill href="https://bucket.spindola.me/cv/CV-ES-ALEXANDRE-SPINDOLA-AI-Native-Full-Stack-Engineer-21-09-2026.pdf">🇪🇸 CV Español</SocialPill>
    </div>
    <nav class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-400" aria-label="Professional profiles">
      <a class="inline-flex items-center gap-2 transition hover:text-primary" href="https://www.linkedin.com/in/alexspindola" target="_blank" rel="noreferrer"><LinkedInIcon class="size-4" />LinkedIn</a>
      <a class="inline-flex items-center gap-2 transition hover:text-primary" href="https://www.xing.com/profile/Alexandre_Spindola" target="_blank" rel="noreferrer"><XingIcon class="size-4" />Xing</a>
      <a class="inline-flex items-center gap-2 transition hover:text-primary" href="https://github.com/alexandrespindola/" target="_blank" rel="noreferrer"><GitHubIcon class="size-4" />GitHub</a>
    </nav>
  </div>

  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-[#343434] bg-[#121212] shadow-2xl">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(64,234,30,0.18),transparent_38%)]"></div>
    <div class="absolute inset-5 rounded-xl border border-[#343434] bg-[#0d0d0d]/70 p-5">
      <div class="flex items-center justify-between"><span class="h-2 w-20 rounded-full bg-primary/70"></span><span class="size-2 rounded-full bg-[#4a4a4a]"></span></div>
      <div class="mt-12 space-y-3"><span class="block h-4 w-3/4 rounded bg-[#3d3d3d]"></span><span class="block h-3 w-full rounded bg-[#292929]"></span><span class="block h-3 w-5/6 rounded bg-[#292929]"></span></div>
      <span class="absolute bottom-5 text-xs font-medium uppercase tracking-[0.2em] text-gray-500">Hero visual placeholder</span>
    </div>
    {heroImage && <img src="/hero.webp" alt="Abstract connected-system visual" width="1200" height="900" loading="eager" class="absolute inset-0 h-full w-full object-cover" />}
  </div>
</div>

<style>
  strong { @apply font-semibold text-primary; }
</style>
