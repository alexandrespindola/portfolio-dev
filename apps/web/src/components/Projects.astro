---
import PROJECTS from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<div class="grid gap-6 md:grid-cols-2">
  {PROJECTS.filter((project) => project.featured).sort((a, b) => (a.featuredOrder ?? 0) - (b.featuredOrder ?? 0)).map((project, index) => (
    <ProjectCard project={project} variant="featured" eager={index === 0} />
  ))}
</div>
<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {PROJECTS.filter((project) => !project.featured).map((project) => (
    <ProjectCard project={project} variant="compact" />
  ))}
</div>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const openButton = target.closest<HTMLButtonElement>("[data-project-open]");
    const closeButton = target.closest<HTMLButtonElement>("[data-project-close]");
    const getDialog = (id: string) => document.getElementById(id) as HTMLDialogElement | null;

    if (openButton) getDialog(openButton.dataset.projectOpen ?? "")?.showModal();
    if (closeButton) getDialog(closeButton.dataset.projectClose ?? "")?.close();
    if (target instanceof HTMLDialogElement && event.target === target) target.close();
  });
</script>
